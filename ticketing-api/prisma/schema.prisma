// PostgreSQL = source of truth for users, money and seat state.
// Catalog data (venues, seat layouts, events, shows) lives in MongoDB — see src/modules/events/schemas.
// Invariants that Prisma cannot express (CHECK constraints, partial indexes) are added by hand
// in the migration SQL; keep them in sync with docs/IMPLEMENTATION_PLAN.md §4.1.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CUSTOMER
  MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  /// Money captured for a booking that was already paid (double payment);
  /// must be refunded in full. Not counted as the booking's settling payment.
  CAPTURED_DUPLICATE
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

// ───────────────────────────── Identity ─────────────────────────────

/// One table for all roles. The same email may exist once per role
/// (a person can hold separate customer and manager accounts).
/// Emails are stored lower-cased (enforced by CHECK constraint).
model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  email        String     @db.VarChar(254)
  phone        String?    @db.VarChar(20)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  name         String     @db.VarChar(120)
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens    RefreshToken[]
  managerProfile   ManagerProfile?  @relation("ManagerProfileUser")
  verifiedManagers ManagerProfile[] @relation("ManagerProfileVerifier")
  bookings         Booking[]

  @@unique([email, role])
  @@index([role, status])
  @@map("users")
}

/// Refresh tokens are stored hashed (SHA-256) and rotated on every use.
/// All tokens issued from one login share a family_id; reuse of a revoked
/// token revokes the whole family.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ip           String?   @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model ManagerProfile {
  userId       String    @id @map("user_id") @db.Uuid
  orgName      String    @map("org_name") @db.VarChar(200)
  contactPhone String?   @map("contact_phone") @db.VarChar(20)
  taxId        String?   @map("tax_id") @db.VarChar(32)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedById String?   @map("verified_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User  @relation("ManagerProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("ManagerProfileVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@map("manager_profiles")
}

// ───────────────────────────── Inventory ─────────────────────────────

/// One row per seat per show, materialized from the Mongo seat layout when a
/// show is published. The conditional UPDATE on this table (… WHERE status = 'AVAILABLE')
/// is the final authority against double booking — Redis holds are only a fast pre-check.
model ShowSeat {
  id            String     @id @default(uuid(7)) @db.Uuid
  /// Mongo ObjectId (24 hex chars) of the show / event
  showId        String     @map("show_id") @db.Char(24)
  eventId       String     @map("event_id") @db.Char(24)
  /// Seat id from the layout, e.g. "A12" — unique within a show
  seatId        String     @map("seat_id") @db.VarChar(16)
  section       String     @db.VarChar(32)
  rowLabel      String     @map("row_label") @db.VarChar(8)
  seatNumber    Int        @map("seat_number")
  priceTier     String     @map("price_tier") @db.VarChar(32)
  price         Decimal    @db.Decimal(10, 2)
  currency      String     @db.Char(3)
  status        SeatStatus @default(AVAILABLE)
  /// Optimistic-lock counter, incremented on every status change
  version       Int        @default(0)
  bookingId     String?    @map("booking_id") @db.Uuid
  holdExpiresAt DateTime?  @map("hold_expires_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bookingItems BookingItem[]

  @@unique([showId, seatId])
  @@index([showId, status])
  @@index([bookingId])
  @@map("show_seats")
}

// ───────────────────────────── Booking ─────────────────────────────

model Booking {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// Human-friendly reference printed on tickets, e.g. "BMS7K2Q9XA"
  bookingRef     String        @unique @map("booking_ref") @db.VarChar(12)
  userId         String        @map("user_id") @db.Uuid
  showId         String        @map("show_id") @db.Char(24)
  eventId        String        @map("event_id") @db.Char(24)
  status         BookingStatus @default(PENDING)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  /// Copied from the show's seats — never defaulted
  currency       String        @db.Char(3)
  holdExpiresAt  DateTime      @map("hold_expires_at") @db.Timestamptz(6)
  idempotencyKey String?       @map("idempotency_key") @db.VarChar(64)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  confirmedAt    DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  /// Set once at the door (conditional update) — later scans report "already used".
  checkedInAt    DateTime?     @map("checked_in_at") @db.Timestamptz(6)

  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     BookingItem[]
  payments  Payment[]
  showSeats ShowSeat[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([showId, status])
  @@map("bookings")
}

/// Seats (and the price paid for each) that belong to a booking. A show seat can
/// appear in several bookings over time (e.g. an expired hold, then a confirmed one),
/// so uniqueness is per booking only; show_seats.booking_id says who owns it now.
model BookingItem {
  id         String  @id @default(uuid(7)) @db.Uuid
  bookingId  String  @map("booking_id") @db.Uuid
  showSeatId String  @map("show_seat_id") @db.Uuid
  price      Decimal @db.Decimal(10, 2)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showSeat ShowSeat @relation(fields: [showSeatId], references: [id], onDelete: Restrict)

  @@unique([bookingId, showSeatId])
  @@index([showSeatId])
  @@map("booking_items")
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  provider          String        @db.VarChar(20)
  providerOrderId   String?       @unique @map("provider_order_id") @db.VarChar(64)
  providerPaymentId String?       @unique @map("provider_payment_id") @db.VarChar(64)
  amount            Decimal       @db.Decimal(10, 2)
  /// Copied from the booking — never defaulted
  currency          String        @db.Char(3)
  status            PaymentStatus @default(CREATED)
  /// Row key "{bookingId}:{attempt}" so a retry after FAILED gets a new row;
  /// the provider-side idempotency key is the bookingId.
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(64)
  attempts          Int           @default(0)
  rawResponse       Json?         @map("raw_response")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([bookingId])
  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amount           Decimal      @db.Decimal(10, 2)
  reason           String       @db.VarChar(255)
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @unique @map("provider_refund_id") @db.VarChar(64)
  idempotencyKey   String       @unique @map("idempotency_key") @db.VarChar(64)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("refunds")
}

/// Dedupe table for payment-provider webhooks (insert … on conflict do nothing).
model ProcessedWebhook {
  provider        String   @db.VarChar(20)
  providerEventId String   @map("provider_event_id") @db.VarChar(128)
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@id([provider, providerEventId])
  @@index([receivedAt])
  @@map("processed_webhooks")
}

/// Stored responses for Idempotency-Key requests (hold, initiate payment, cancel).
model IdempotencyKey {
  key            String   @db.VarChar(64)
  userId         String   @map("user_id") @db.Uuid
  route          String   @db.VarChar(128)
  /// SHA-256 of the request body — same key with a different body is rejected
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([userId, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ───────────────────────────── Messaging & audit ─────────────────────────────

/// Transactional outbox: rows are written in the same transaction as the state
/// change and relayed to Kafka asynchronously.
model OutboxEvent {
  id           BigInt       @id @default(autoincrement())
  aggregate    String       @db.VarChar(32)
  aggregateId  String       @map("aggregate_id") @db.VarChar(64)
  topic        String       @db.VarChar(64)
  payload      Json
  headers      Json?
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  lastError    String?      @map("last_error")
  /// Lease: a relay instance owns the row until this time (send happens outside any transaction).
  claimedUntil DateTime?    @map("claimed_until") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt       DateTime?    @map("sent_at") @db.Timestamptz(6)

  @@map("outbox")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  actorRole Role?    @map("actor_role")
  action    String   @db.VarChar(64)
  entity    String   @db.VarChar(32)
  entityId  String   @map("entity_id") @db.VarChar(64)
  payload   Json?
  ip        String?  @db.VarChar(45)
  requestId String?  @map("request_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("audit_logs")
}

# Copy to .env for local development. Every variable is validated at startup (src/config/env.ts).
NODE_ENV=development
PORT=4000
# Reverse-proxy hops to trust for X-Forwarded-For (0 when the API is exposed directly)
TRUST_PROXY_HOPS=0
# Optional locally, required in production: GET /metrics needs Authorization: Bearer <token>
METRICS_TOKEN=
LOG_LEVEL=debug
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://ticketing:ticketing@localhost:5432/ticketing?schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=5000
MONGO_URL=mongodb://localhost:27017/ticketing?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=false
MAIL_FROM=Ticketing <no-reply@ticketing.local>

# Auth — generate a real secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
MANAGER_AUTO_APPROVE=false

# Booking policy
SEAT_HOLD_TTL_SECONDS=300
MAX_SEATS_PER_BOOKING=10
MAX_ACTIVE_HOLDS_PER_USER=2
CANCELLATION_CUTOFF_HOURS=4
CANCELLATION_FEE_PERCENT=10

# Background processing
WORKERS_ENABLED=true
OUTBOX_RELAY_ENABLED=true
KAFKA_CLIENT_ID=ticketing-api
# openssl rand -base64 48
TICKET_SIGNING_SECRET=dev-only-ticket-secret-0123456789abcdefghijkl

# Payments: fake (local signing, dev/test only) | razorpay
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_SECRET=fake-payment-secret-dev-only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seed accounts (development only). The seed refuses non-local hosts unless SEED_ALLOW_REMOTE=true.
SEED_ADMIN_EMAIL=admin@ticketing.local
SEED_ADMIN_PASSWORD=ChangeMe!Admin123
SEED_MANAGER_EMAIL=manager@ticketing.local
SEED_MANAGER_PASSWORD=ChangeMe!Manager123
SEED_CUSTOMER_EMAIL=customer@ticketing.local
SEED_CUSTOMER_PASSWORD=ChangeMe!Customer123

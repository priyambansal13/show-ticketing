# Copy to .env.local. Only NEXT_PUBLIC_* values are exposed to the browser.

# NestJS API origin. Server-side only: Server Components fetch the catalog from it, and
# the browser's /api/v1/* calls are proxied to it (next.config.ts rewrites).
API_ORIGIN=http://localhost:4000

# Socket.IO (live seat map) connects straight to the API — WebSockets are not proxied.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Comma-separated https hosts allowed for event posters (next/image). Others show a placeholder.
NEXT_PUBLIC_IMAGE_HOSTS=images.unsplash.com

# Policy numbers shown to customers (seat limit, cancellation copy). The API enforces the real values —
# keep these equal to the API's MAX_SEATS_PER_BOOKING / CANCELLATION_CUTOFF_HOURS / CANCELLATION_FEE_PERCENT.
NEXT_PUBLIC_MAX_SEATS_PER_BOOKING=10
NEXT_PUBLIC_CANCELLATION_CUTOFF_HOURS=4
NEXT_PUBLIC_CANCELLATION_FEE_PERCENT=10

# Deployment note (rate limits): behind this app's /api/v1 proxy the API sees the web server as the
# client. Next.js forwards an incoming X-Forwarded-For unchanged, so put an edge proxy/load balancer in
# front that OVERWRITES X-Forwarded-For with the real client IP, and set the API's TRUST_PROXY_HOPS to
# the number of proxies (edge + this app). Never trust X-Forwarded-For with Next.js directly exposed.
